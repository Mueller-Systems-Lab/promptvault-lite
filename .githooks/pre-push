#!/bin/sh
# Repository-managed pre-push defense: reject NON-FAST-FORWARD ref updates.
#
# Policy: no force push, on any branch. This hook enforces the *effect* — a ref
# update that would rewrite published history — no matter how the push was
# invoked (`--force`, `-f`, `--force-with-lease`, `--force-if-includes`, or a
# forced `+refspec` all reduce to the same non-fast-forward update here).
#
# A pre-push hook sees the resulting ref update, not the original CLI flags.
# It therefore proves "a local non-fast-forward push is rejected"; it does not
# by itself prove that a given flag was never typed. Command-level intent is
# covered separately (`.zcode/config.json` + scripts/governance/force-push-hook.mjs),
# and the server-side effect is covered by the GitHub ruleset.
#
# Git passes on stdin one line per ref:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# with an all-zero object name meaning "does not exist" (new branch, or deletion).
#
# Rules:
#   * new branch (remote sha all zeros)      -> allow
#   * deletion   (local sha all zeros)       -> allow (deletions are not rewrites)
#   * unchanged  (local sha == remote sha)   -> allow
#   * fast-forward (remote sha is an ancestor of local sha) -> allow
#   * anything else                          -> reject
#
# No network access, no fetch, no repository mutation.

remote_name="$1"
remote_url="$2"

zero_sha() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Ignore malformed/blank lines rather than failing the push for the wrong reason.
  [ -n "$local_sha" ] || continue

  if zero_sha "$remote_sha"; then
    continue            # new branch on the remote
  fi
  if zero_sha "$local_sha"; then
    continue            # deletion
  fi
  if [ "$local_sha" = "$remote_sha" ]; then
    continue            # nothing to update
  fi

  if git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    continue            # fast-forward
  fi

  echo "NON_FAST_FORWARD_PUSH_BLOCKED_BY_PROJECT_POLICY" >&2
  echo "  ref:     $remote_ref" >&2
  echo "  remote:  $remote_name ($remote_url)" >&2
  echo "  update:  $remote_sha -> $local_sha" >&2
  echo "  This repository does not permit rewriting history on any branch." >&2
  echo "  Add a correction commit, or fetch and rebase/merge locally first." >&2
  status=1
done

exit $status
