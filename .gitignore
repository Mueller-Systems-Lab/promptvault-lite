# =============================================================================
# PromptVault Lite — .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
target/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Private user corpora / cloud credentials — never tracked, never packaged.
# (Review packages additionally exclude these by policy; see
#  scripts/create-review-package.mjs and docs/audits/reviews/README.md.)
/Promps/
/.aws/

# Logs
*.log

# OpenCode Session-Workspace (Sub-Installation mit eigenem node_modules)
.opencode/

# Tauri
src-tauri/gen/
src-tauri/Cargo.lock

# Test
coverage/
*.lcov

# Cache
.cache/
*.db
*.db-journal
*.db-wal

# WIP / Isolated Features (nicht für Release-Scope)
.tmp/
scripts/*
!scripts/verify-all.mjs
!scripts/e19-gate.mjs
!scripts/check_version_consistency.py
!scripts/semantic_quality_metrics.py
!scripts/contamination_scan.py
!scripts/security-gate.mjs
!scripts/docker-smoke.sh
!scripts/eval-flywheel.mjs
!scripts/verify-release-artifacts.mjs
!scripts/create-review-package.mjs
!scripts/validate-review-evidence.mjs
!scripts/lib/
!scripts/__tests__/
# Release-Pipeline (v1.13.2): Staging-Skript + Workflow-Bausteine
!scripts/release/
# LAN/LXC deployment verification harness (Issue #138)
!scripts/lan-verify/
site/

# Python cache
__pycache__/
.worktrees/

# Local Playwright/MCP runtime artifacts
.playwright-mcp/

# Local test evidence (screenshots, reports with private paths/content)
evidence/

# Playwright E2E Outputs (Privacy: contains screenshots, traces, videos)
test-results/
playwright-report/
playwright/.cache/
playwright/.auth/
*.trace.zip

# Playwright Visual Comparison Snapshots
**/__snapshots__/

# E2E configuration with private paths (NEVER commit)
tests/e2e/.env.local
tests/e2e/corpus-config.ts
playwright.config.local.ts

# vite transient config dumps
vite.config.ts.timestamp-*.mjs
