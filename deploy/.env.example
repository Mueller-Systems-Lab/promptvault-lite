# =============================================================================
# promptvault-server — Beispielumgebung (issue #127 / H2)
# Kopieren nach deploy/.env und Werte setzen. NIEMALS committen (.gitignore).
# =============================================================================

# Host-Pfad des Prompt-Vaults (NAS/LAN-Mount, read-only empfohlen)
PROMPTVAULT_VAULT_HOST_PATH=/mnt/nas/prompts

# Externer Bind (Default 127.0.0.1 — nur lokal). Für LAN: Host-IP des
# Docker-Hosts, NIEMALS 0.0.0.0 ohne zusätzliche Netzwerk-Kontrolle.
PROMPTVAULT_BIND=127.0.0.1:8080

# Scan-Autorisierung (ab v1.13.2). Ohne diese Variable darf POST /api/scan nur
# den gemounteten Vault (/vault) und dessen Unterverzeichnisse scannen
# (Least Privilege). Weitere Container-Pfade nur bewusst freigeben, z. B.:
#   PROMPTVAULT_SERVER_SCAN_ROOTS=/vault:/opt/extra-prompts
# Der Wert "*" hebt die Beschränkung auf (uneingeschränktes Scannen — nur für
# einen vertrauenswürdigen Host). Nicht gesetzt/leer = Default (nur /vault).
#PROMPTVAULT_SERVER_SCAN_ROOTS=/vault
