{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mueller-Systems-Lab/promptvault-lite/.agents/schemas/project-contract.v1.schema.json",
  "title": "PromptVault Lite project contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "project", "paths", "writePolicy", "workspacePolicy", "enforcementEvidence"],
  "properties": {
    "contractVersion": { "type": "string", "const": "1.0.0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "repository", "defaultBranch", "canonicalRemotes", "approvedForks", "rootMarker"],
      "properties": {
        "provider": { "type": "string", "const": "github" },
        "owner": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "canonicalRemotes": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "approvedForks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "repository", "canonicalRemotes"],
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "repository": { "type": "string", "minLength": 1 },
              "canonicalRemotes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "rootMarker": { "type": "string", "const": "git-repository-root" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "specs", "skills", "tests", "evidence"],
      "properties": {
        "instructions": { "type": "string", "minLength": 1 },
        "specs": { "$ref": "#/$defs/relativePathList" },
        "skills": { "$ref": "#/$defs/relativePathList" },
        "tests": { "$ref": "#/$defs/relativePathList" },
        "evidence": { "$ref": "#/$defs/relativePathList" }
      }
    },
    "writePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted", "restricted"],
      "properties": {
        "permitted": { "$ref": "#/$defs/relativePathList" },
        "restricted": { "$ref": "#/$defs/relativePathList" }
      }
    },
    "workspacePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noNestedProjectRoot", "nestedRoots", "preflight", "configurationShadowing"],
      "properties": {
        "noNestedProjectRoot": { "type": "boolean", "const": true },
        "nestedRoots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "kind": { "type": "string", "enum": ["module", "worktree", "submodule", "vendored-example"] }
            }
          }
        },
        "preflight": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "configurationShadowing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inspectApplicableInstructions", "inspectApplicableGlobalSkills", "recordActiveRuntime", "doNotInferEnforcementFromDocumentation"],
          "properties": {
            "inspectApplicableInstructions": { "type": "boolean", "const": true },
            "inspectApplicableGlobalSkills": { "type": "boolean", "const": true },
            "recordActiveRuntime": { "type": "boolean", "const": true },
            "doNotInferEnforcementFromDocumentation": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "enforcementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryInstructions", "contractValidator", "writePathPolicyValidator", "writeBoundaryEnforcement", "preCommitHook", "writeBroker", "globalOpenCodeRuntime"],
      "properties": {
        "repositoryInstructions": { "type": "string", "enum": ["DOCUMENT_ONLY", "NOT_VERIFIED"] },
        "contractValidator": { "type": "string", "enum": ["VALIDATOR_AVAILABLE", "NOT_VERIFIED"] },
        "writePathPolicyValidator": { "type": "string", "enum": ["VALIDATOR_AVAILABLE", "NOT_VERIFIED"] },
        "writeBoundaryEnforcement": { "type": "string", "enum": ["TOOL_GAP", "NOT_VERIFIED"] },
        "preCommitHook": { "type": "string", "enum": ["HOOK_ENFORCED", "TOOL_GAP", "NOT_VERIFIED"] },
        "writeBroker": { "type": "string", "enum": ["BROKER_ENFORCED", "TOOL_GAP", "NOT_VERIFIED"] },
        "globalOpenCodeRuntime": { "type": "string", "enum": ["DOCUMENT_ONLY", "VALIDATOR_AVAILABLE", "HOOK_ENFORCED", "BROKER_ENFORCED", "TOOL_GAP", "NOT_VERIFIED"] }
      }
    }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![/\\\\])(?!.*\\\\)(?![A-Za-z]:[/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*(?:^|[/\\\\])\\.(?:[/\\\\]|$)).+$" },
    "relativePathList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }
  }
}
